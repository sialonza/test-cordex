//@version=5
indicator("Big Move Predictor - Ultra v3", overlay=true,
     max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ============================================================
//  銘柄タイプ自動判定
// ============================================================
isCrypto = syminfo.type == "crypto"
isStock  = syminfo.type == "stock"
isForex  = syminfo.type == "forex"
isFutures = syminfo.type == "futures"
isIndex  = syminfo.type == "index"

// ============================================================
//  入力パラメータ
// ============================================================
grp1 = "Core"
sqzLen      = input.int(20, "Squeeze Period", minval=5, group=grp1)
atrLen      = input.int(14, "ATR Period", minval=2, group=grp1)
volLen      = input.int(20, "Volume MA Period", minval=5, group=grp1)
minScore    = input.int(55, "Min Signal Score %", minval=10, maxval=100, group=grp1)
confirmBars = input.int(5, "Confirmation Window (bars)", minval=1, maxval=20, group=grp1)

grp2 = "MTF Squeeze"
useMTF      = input.bool(true, "Multi-Timeframe Squeeze", group=grp2)

grp3 = "Cross-Asset"
useDXY      = input.bool(true, "DXY Correlation", group=grp3)
useGold     = input.bool(true, "Gold Correlation", group=grp3)
useSPX      = input.bool(true, "S&P500 Correlation", group=grp3)

grp4 = "Seasonality"
useSeason   = input.bool(true, "Seasonality Filter", group=grp4)

grp5 = "Adaptive"
useAdaptive = input.bool(true, "Adaptive Thresholds", group=grp5)
regimeLen   = input.int(100, "Regime Detection Period", minval=20, group=grp5)

grp6 = "Visual"
highColor   = input.color(color.new(#FFD600, 0), "S Grade", group=grp6)
midColor    = input.color(color.new(#FF9100, 0), "A Grade", group=grp6)
lowColor    = input.color(color.new(#29B6F6, 0), "B Grade", group=grp6)
showLabels  = input.bool(true, "Show Labels", group=grp6)
showBG      = input.bool(true, "Show Background", group=grp6)
showStats   = input.bool(true, "Show Hit Rate Stats", group=grp6)

grp7 = "Alerts"
alertEnabled = input.bool(true, "Enable Alerts", group=grp7)

// ============================================================
//  基本指標
// ============================================================
atrVal     = ta.atr(atrLen)
atrSMA     = ta.sma(atrVal, sqzLen)
rsiVal     = ta.rsi(close, 14)
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)
ema9       = ta.ema(close, 9)
ema21      = ta.ema(close, 21)
ema50      = ta.ema(close, 50)
ema200     = ta.ema(close, 200)
obv_       = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvEma     = ta.ema(obv_, 20)
volSMA     = ta.sma(volume, volLen)
volRatio   = volSMA > 0 ? volume / volSMA : 1.0

// ============================================================
//  市場レジーム検出（適応型閾値用）
// ============================================================
hvol = ta.stdev(math.log(close / close[1]), regimeLen) * math.sqrt(365) * 100
hvolSMA = ta.sma(hvol, regimeLen)
isLowVolRegime  = hvol < hvolSMA * 0.7
isHighVolRegime = hvol > hvolSMA * 1.3

// 適応型乗数（低ボラ相場ではより敏感に、高ボラ相場ではより厳格に）
adaptMult = useAdaptive ? (isLowVolRegime ? 1.3 : isHighVolRegime ? 0.7 : 1.0) : 1.0

// ============================================================
//  1. BB Squeeze (max 12)
// ============================================================
[bbUpper, bbBasis, bbLower] = ta.bb(close, sqzLen, 2.0)
bbWidth    = bbBasis > 0 ? (bbUpper - bbLower) / bbBasis * 100 : 0
bbWidthSMA = ta.sma(bbWidth, sqzLen)
bbWidthMin = ta.lowest(bbWidth, sqzLen * 2)
bbWidthMax = ta.highest(bbWidth, sqzLen * 2)
bbCompression = bbWidthMax > bbWidthMin ? 1.0 - (bbWidth - bbWidthMin) / (bbWidthMax - bbWidthMin) : 0
bbSqueeze  = bbWidth < bbWidthSMA * 0.75

// ============================================================
//  2. KC Squeeze (max 15)
// ============================================================
kcMid   = ta.ema(close, sqzLen)
kcRange = ta.atr(sqzLen) * 1.5
kcUpper = kcMid + kcRange
kcLower = kcMid - kcRange
kcSqueeze = bbUpper < kcUpper and bbLower > kcLower

// ============================================================
//  3. ATR圧縮 (max 10)
// ============================================================
atrMin = ta.lowest(atrVal, sqzLen)
atrMax = ta.highest(atrVal, sqzLen)
atrCompression = atrMax > atrMin ? 1.0 - (atrVal - atrMin) / (atrMax - atrMin) : 0

// ============================================================
//  4. 出来高枯渇 (max 8)
// ============================================================
volDryUp = volRatio < 0.6
volDecayCount = 0
for i = 0 to 4
    if volume[i] < volSMA[i]
        volDecayCount += 1

// ============================================================
//  5. Narrow Range (max 8)
// ============================================================
range_   = high - low
rangeSMA = ta.sma(range_, sqzLen)
nrCount = 0
for i = 0 to 3
    if rangeSMA[i] > 0 and (high[i] - low[i]) < rangeSMA[i] * 0.6
        nrCount += 1

// ============================================================
//  6. Inside Bar (max 6)
// ============================================================
insideBarCount = 0
for i = 0 to 4
    if high[i] < high[i+1] and low[i] > low[i+1]
        insideBarCount += 1

// ============================================================
//  7. RSI圧縮 (max 6)
// ============================================================
rsiHi = ta.highest(rsiVal, sqzLen)
rsiLo = ta.lowest(rsiVal, sqzLen)
rsiRange_ = rsiHi - rsiLo
rsiCompressed = rsiRange_ < 15

// ============================================================
//  8. MACD平坦化 (max 5)
// ============================================================
macdHistAbs = math.abs(macdHist)
macdHistSMA = ta.sma(macdHistAbs, sqzLen)
macdFlat = macdHistSMA > 0 ? macdHistAbs < macdHistSMA * 0.3 : false

// ============================================================
//  9. 三角持ち合い (max 8)
// ============================================================
highLine  = ta.highest(high, sqzLen)
lowLine   = ta.lowest(low, sqzLen)
priceRng  = highLine - lowLine
priceRngPrev = ta.highest(high, sqzLen)[sqzLen] - ta.lowest(low, sqzLen)[sqzLen]
triComp = priceRngPrev > 0 ? priceRng / priceRngPrev : 1.0
isTriangle = triComp < 0.6

// ============================================================
// 10. EMA収束 (max 4)
// ============================================================
emaDiff = close > 0 ? math.abs(ema9 - ema21) / close * 100 : 0
emaConverging = emaDiff < 0.3

// ============================================================
// 11. MTF Squeeze合流 (max 12)
// ============================================================
f_htfSqueeze(tf) =>
    [bu, bm, bl] = request.security(syminfo.tickerid, tf, ta.bb(close, 20, 2.0), lookahead=barmerge.lookahead_off)
    km = request.security(syminfo.tickerid, tf, ta.ema(close, 20), lookahead=barmerge.lookahead_off)
    kr = request.security(syminfo.tickerid, tf, ta.atr(20) * 1.5, lookahead=barmerge.lookahead_off)
    ku = km + kr
    kl = km - kr
    not na(bu) and not na(ku) ? (bu < ku and bl > kl) : false

htfSqz1 = useMTF and timeframe.isintraday ? f_htfSqueeze(timeframe.multiplier <= 15 ? "60" : "240") : false
htfSqz2 = useMTF ? f_htfSqueeze(timeframe.isintraday ? "D" : "W") : false

// ============================================================
// 12. クロスアセット相関 - 銘柄タイプ別自動選択 (max 9)
// ============================================================
// 参照先: Crypto→DXY/Gold/SPX, 株→VIX/DXY/債券, FX→DXY/Gold/債券

// Asset1: DXY（全タイプ共通）
a1Close = useDXY ? request.security("TVC:DXY", timeframe.period, close, lookahead=barmerge.lookahead_off) : na
a1ATR   = useDXY ? request.security("TVC:DXY", timeframe.period, ta.atr(14), lookahead=barmerge.lookahead_off) : na
a1Change = not na(a1Close) and not na(a1Close[1]) ? math.abs(a1Close - a1Close[1]) : 0
dxyVolatile = not na(a1ATR) and a1ATR > 0 ? a1Change > a1ATR * 1.5 : false

// Asset2: Crypto→Gold, 株→VIX, FX→Gold
a2Sym = isCrypto ? "TVC:GOLD" : isStock or isIndex ? "CBOE:VIX" : "TVC:GOLD"
a2Close = useGold ? request.security(a2Sym, timeframe.period, close, lookahead=barmerge.lookahead_off) : na
a2ATR   = useGold ? request.security(a2Sym, timeframe.period, ta.atr(14), lookahead=barmerge.lookahead_off) : na
a2Change = not na(a2Close) and not na(a2Close[1]) ? math.abs(a2Close - a2Close[1]) : 0
goldVolatile = not na(a2ATR) and a2ATR > 0 ? a2Change > a2ATR * 1.5 : false

// Asset3: Crypto→SPX, 株→US10Y, FX→SPX
a3Sym = isCrypto ? "SP:SPX" : isStock or isIndex ? "TVC:US10Y" : "SP:SPX"
a3Close = useSPX ? request.security(a3Sym, timeframe.period, close, lookahead=barmerge.lookahead_off) : na
a3ATR   = useSPX ? request.security(a3Sym, timeframe.period, ta.atr(14), lookahead=barmerge.lookahead_off) : na
a3Change = not na(a3Close) and not na(a3Close[1]) ? math.abs(a3Close - a3Close[1]) : 0
spxVolatile = not na(a3ATR) and a3ATR > 0 ? a3Change > a3ATR * 1.5 : false

// ============================================================
// 13. 曜日・時間帯の季節性 - 銘柄タイプ別 (max 5)
// ============================================================
dow = dayofweek
hourNow = hour
isVolatileDay = false
isVolatileHour = false
if useSeason
    if isCrypto
        // Crypto: 月曜早朝、水木（米指標）、金（週末前調整）
        isVolatileDay := dow == dayofweek.monday or dow == dayofweek.wednesday or dow == dayofweek.thursday or dow == dayofweek.friday
        isVolatileHour := timeframe.isintraday ? (hourNow >= 13 and hourNow <= 21) or (hourNow >= 0 and hourNow <= 3) : false
    else if isStock or isIndex or isFutures
        // 株/指数: 月曜ギャップ、水（FOMC等）、金（オプションSQ）
        isVolatileDay := dow == dayofweek.monday or dow == dayofweek.wednesday or dow == dayofweek.friday
        isVolatileHour := timeframe.isintraday ? (hourNow >= 13 and hourNow <= 16) or (hourNow >= 19 and hourNow <= 21) : false
    else if isForex
        // FX: 火水木（流動性ピーク）
        isVolatileDay := dow == dayofweek.tuesday or dow == dayofweek.wednesday or dow == dayofweek.thursday
        isVolatileHour := timeframe.isintraday ? (hourNow >= 7 and hourNow <= 9) or (hourNow >= 13 and hourNow <= 16) : false
    else
        isVolatileDay := dow != dayofweek.saturday and dow != dayofweek.sunday
        isVolatileHour := true

// ============================================================
// 14. ローソク足パターン認識（圧縮ゾーン出口）(max 5)
// ============================================================
// Doji（実体が非常に小さい）
bodySize = math.abs(close - open)
candleRange = high - low
isDoji = candleRange > 0 ? bodySize / candleRange < 0.1 : false

// Spinning Top
isSpinningTop = candleRange > 0 ? bodySize / candleRange < 0.3 and bodySize / candleRange > 0.1 : false

// Hammer / Inverted Hammer
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
isHammer = candleRange > 0 ? lowerWick > bodySize * 2 and upperWick < bodySize * 0.5 : false
isInvHammer = candleRange > 0 ? upperWick > bodySize * 2 and lowerWick < bodySize * 0.5 : false

// Engulfing
bullEngulf = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bearEngulf = close < open and close[1] > open[1] and close < open[1] and open > close[1]

candleSignal = isDoji or isSpinningTop or isHammer or isInvHammer or bullEngulf or bearEngulf

// ============================================================
//  スコア計算（適応型）
// ============================================================
score = 0.0

// (1) BB Squeeze max12
score += bbSqueeze ? 7.0 * adaptMult : 0.0
score += bbCompression * 5.0 * adaptMult

// (2) KC Squeeze max15
score += kcSqueeze ? 15.0 * adaptMult : 0.0

// (3) ATR圧縮 max10
score += atrCompression * 10.0 * adaptMult

// (4) 出来高枯渇 max8
score += volDryUp ? 4.0 : 0.0
score += math.min(4.0, volDecayCount * 0.8)

// (5) Narrow Range max8
score += math.min(8.0, nrCount * 2.0)

// (6) Inside Bar max6
score += math.min(6.0, insideBarCount * 1.5)

// (7) RSI圧縮 max6
score += rsiCompressed ? 6.0 : 0.0

// (8) MACD平坦化 max5
score += macdFlat ? 5.0 : 0.0

// (9) 三角持ち合い max8
score += isTriangle ? 8.0 : 0.0

// (10) EMA収束 max4
score += emaConverging ? 4.0 : 0.0

// (11) MTF Squeeze合流 max12
score += htfSqz1 ? 6.0 : 0.0
score += htfSqz2 ? 6.0 : 0.0

// (12) クロスアセット max9
score += dxyVolatile ? 3.0 : 0.0
score += goldVolatile ? 3.0 : 0.0
score += spxVolatile ? 3.0 : 0.0

// (13) 季節性 max5
score += isVolatileDay ? 3.0 : 0.0
score += isVolatileHour ? 2.0 : 0.0

// (14) ローソク足パターン max5
score += candleSignal ? 5.0 : 0.0

// 正規化（最大118pt → 100%）
finalScore = math.min(100.0, math.round(score / 1.18))

// ============================================================
//  方向予測 v2（22因子・重み付きスコアリング）
// ============================================================
bullW = 0.0   // 重み付きブルスコア（max ~50）
bearW = 0.0   // 重み付きベアスコア（max ~50）

// ---- (D1) RSI位置 [max 5] ----
if rsiVal < 25
    bullW += 5.0
else if rsiVal < 30
    bullW += 3.5
else if rsiVal < 40
    bullW += 1.5
if rsiVal > 75
    bearW += 5.0
else if rsiVal > 70
    bearW += 3.5
else if rsiVal > 60
    bearW += 1.5

// ---- (D2) RSIモメンタム（方向変化）[max 3] ----
rsiMom = rsiVal - rsiVal[3]
if rsiMom > 8
    bullW += 3.0
else if rsiMom > 4
    bullW += 1.5
if rsiMom < -8
    bearW += 3.0
else if rsiMom < -4
    bearW += 1.5

// ---- (D3) EMA配列＋ゴールデン/デッドクロス [max 5] ----
if ema9 > ema21 and ema21 > ema50
    bullW += 3.0
if ema9 < ema21 and ema21 < ema50
    bearW += 3.0
// ゴールデンクロス直近
if ta.crossover(ema9, ema21)
    bullW += 2.0
if ta.crossunder(ema9, ema21)
    bearW += 2.0

// ---- (D4) EMA200位置 [max 2] ----
if not na(ema200)
    dist200 = close > 0 ? (close - ema200) / close * 100 : 0
    if dist200 > 3
        bullW += 2.0
    else if dist200 > 0
        bullW += 1.0
    if dist200 < -3
        bearW += 2.0
    else if dist200 < 0
        bearW += 1.0

// ---- (D5) MACDヒストグラム＋方向 [max 4] ----
if macdHist > 0
    bullW += 1.5
    if macdHist > macdHist[1]
        bullW += 2.5  // 加速
if macdHist < 0
    bearW += 1.5
    if macdHist < macdHist[1]
        bearW += 2.5

// ---- (D6) MACDクロスオーバー [max 2] ----
if ta.crossover(macdLine, signalLine)
    bullW += 2.0
if ta.crossunder(macdLine, signalLine)
    bearW += 2.0

// ---- (D7) OBVトレンド [max 3] ----
obvSlope = obv_ - obv_[5]
if obv_ > obvEma and obvSlope > 0
    bullW += 3.0
else if obv_ > obvEma
    bullW += 1.5
if obv_ < obvEma and obvSlope < 0
    bearW += 3.0
else if obv_ < obvEma
    bearW += 1.5

// ---- (D8) 出来高・価格乖離（スマートマネー）[max 3] ----
// 価格上昇+出来高増 = 本物のブル、価格上昇+出来高減 = 弱いブル
priceUp3 = close > close[3]
volUp3 = volume > ta.sma(volume, 10)
if priceUp3 and volUp3
    bullW += 3.0  // 強い買い
else if priceUp3 and not volUp3
    bearW += 1.0  // ダイバージェンス（弱い上昇）
if not priceUp3 and volUp3
    bearW += 3.0  // 強い売り
else if not priceUp3 and not volUp3
    bullW += 1.0  // セリングクライマックス近い

// ---- (D9) StochRSI [max 3] ----
stochK = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, 14), 3)
stochD = ta.sma(stochK, 3)
if stochK < 20 and ta.crossover(stochK, stochD)
    bullW += 3.0
else if stochK < 30
    bullW += 1.0
if stochK > 80 and ta.crossunder(stochK, stochD)
    bearW += 3.0
else if stochK > 70
    bearW += 1.0

// ---- (D10) スクイーズモメンタム方向（TTMスタイル）[max 4] ----
sqzMom = close - (ta.highest(high, sqzLen) + ta.lowest(low, sqzLen)) / 2
sqzMomEma = ta.ema(sqzMom, sqzLen)
if sqzMom > 0 and sqzMom > sqzMom[1]
    bullW += 4.0  // 上方向に加速
else if sqzMom > 0
    bullW += 2.0
if sqzMom < 0 and sqzMom < sqzMom[1]
    bearW += 4.0
else if sqzMom < 0
    bearW += 2.0

// ---- (D11) マーケット構造（HH/HL vs LH/LL）[max 4] ----
swH1 = ta.highest(high, 10)
swL1 = ta.lowest(low, 10)
swH2 = ta.highest(high, 10)[10]
swL2 = ta.lowest(low, 10)[10]
higherHigh = swH1 > swH2
higherLow  = swL1 > swL2
lowerHigh  = swH1 < swH2
lowerLow   = swL1 < swL2
if higherHigh and higherLow
    bullW += 4.0  // 上昇トレンド構造
else if higherLow
    bullW += 2.0
if lowerHigh and lowerLow
    bearW += 4.0  // 下降トレンド構造
else if lowerHigh
    bearW += 2.0

// ---- (D12) ROC（変化率）[max 2] ----
roc10 = close > 0 and close[10] > 0 ? (close - close[10]) / close[10] * 100 : 0
if roc10 > 3
    bullW += 2.0
else if roc10 > 0
    bullW += 0.5
if roc10 < -3
    bearW += 2.0
else if roc10 < 0
    bearW += 0.5

// ---- (D13) HTF RSI [max 3] ----
rsi_htf = request.security(syminfo.tickerid,
     timeframe.isintraday ? (timeframe.multiplier <= 60 ? "240" : "D") : "W",
     ta.rsi(close, 14), lookahead=barmerge.lookahead_off)
if not na(rsi_htf)
    if rsi_htf < 30
        bullW += 3.0
    else if rsi_htf < 40
        bullW += 1.5
    if rsi_htf > 70
        bearW += 3.0
    else if rsi_htf > 60
        bearW += 1.5

// ---- (D14) HTFトレンド（EMA on HTF）[max 2] ----
htfEma9 = request.security(syminfo.tickerid,
     timeframe.isintraday ? "D" : "W",
     ta.ema(close, 9), lookahead=barmerge.lookahead_off)
htfEma21 = request.security(syminfo.tickerid,
     timeframe.isintraday ? "D" : "W",
     ta.ema(close, 21), lookahead=barmerge.lookahead_off)
if not na(htfEma9) and not na(htfEma21)
    if htfEma9 > htfEma21
        bullW += 2.0
    else
        bearW += 2.0

// ---- (D15) DXY逆相関 [max 2] ----
if not na(a1Close) and not na(a1Close[1])
    dxyChg = (a1Close - a1Close[1]) / a1Close[1] * 100
    if isCrypto or isForex
        if dxyChg < -0.3
            bullW += 2.0
        else if dxyChg < 0
            bullW += 0.5
        if dxyChg > 0.3
            bearW += 2.0
        else if dxyChg > 0
            bearW += 0.5
    else
        if dxyChg > 0.3
            bullW += 1.0
        if dxyChg < -0.3
            bearW += 1.0

// ---- (D16) Engulfingパターン [max 3] ----
if bullEngulf
    bullW += 3.0
if bearEngulf
    bearW += 3.0

// ---- (D17) Hammer/Shooting Star [max 2] ----
if isHammer
    bullW += 2.0
if isInvHammer and close < open
    bearW += 2.0

// ---- (D18) BBバンド位置 [max 2] ----
bbPos = bbUpper > bbLower ? (close - bbLower) / (bbUpper - bbLower) : 0.5
if bbPos < 0.1
    bullW += 2.0  // 下限→反発期待
else if bbPos < 0.3
    bullW += 1.0
if bbPos > 0.9
    bearW += 2.0  // 上限→反落期待
else if bbPos > 0.7
    bearW += 1.0

// ---- (D19) 連続陽線/陰線 [max 2] ----
consGreen = 0
consRed = 0
for i = 0 to 4
    if close[i] > open[i]
        consGreen += 1
    else
        break
for i = 0 to 4
    if close[i] < open[i]
        consRed += 1
    else
        break
if consGreen >= 3
    bullW += math.min(2.0, consGreen * 0.5)
if consRed >= 3
    bearW += math.min(2.0, consRed * 0.5)

// ---- (D20) 価格とボリュームの相関（Accumulation/Distribution）[max 2] ----
mfm = candleRange > 0 ? ((close - low) - (high - close)) / candleRange : 0
adLine = ta.cum(mfm * volume)
adEma = ta.ema(adLine, 20)
if adLine > adEma
    bullW += 2.0
if adLine < adEma
    bearW += 2.0

// ---- (D21) Pivot位置（Support/Resistance近接）[max 1] ----
pvtHi = ta.pivothigh(high, 10, 10)
pvtLo = ta.pivotlow(low, 10, 10)
var float lastPvtHi = na
var float lastPvtLo = na
if not na(pvtHi)
    lastPvtHi := pvtHi
if not na(pvtLo)
    lastPvtLo := pvtLo
if not na(lastPvtLo) and close > 0
    if math.abs(close - lastPvtLo) / close < 0.01
        bullW += 1.0  // サポート近接
if not na(lastPvtHi) and close > 0
    if math.abs(close - lastPvtHi) / close < 0.01
        bearW += 1.0  // レジスタンス近接

// ---- (D22) Asset2相関方向（Gold/VIX）[max 1] ----
if not na(a2Close) and not na(a2Close[1])
    if isCrypto
        // Gold上昇＝リスクヘッジ＝crypto微弱ベア
        if a2Close > a2Close[1]
            bearW += 0.5
        else
            bullW += 0.5
    else if isStock or isIndex
        // VIX上昇＝恐怖＝株ベア
        if a2Close > a2Close[1]
            bearW += 1.0
        else
            bullW += 1.0

// ============================================================
//  方向確率の算出
// ============================================================
totalDir = bullW + bearW
dirScore = bullW - bearW

// 方向確率（50%=中立、100%=完全に片方向）
dirProb = totalDir > 0 ? math.round(math.max(bullW, bearW) / totalDir * 100) : 50
isBullDir = bullW > bearW
isBearDir = bearW > bullW

// 方向信頼度（確率の段階分け）
dirConf = dirProb >= 75 ? "HIGH" : dirProb >= 62 ? "MID" : "LOW"
dirConfCol = dirProb >= 75 ? #00E676 : dirProb >= 62 ? #FFD600 : #8B949E

// ============================================================
//  シグナル判定
// ============================================================
isSignal = finalScore >= minScore
var int lastSigBar = 0
isNew = isSignal and (bar_index - lastSigBar) >= 3
if isNew
    lastSigBar := bar_index

grade = finalScore >= 80 ? "S" : finalScore >= 65 ? "A" : "B"
gradeColor = finalScore >= 80 ? highColor : finalScore >= 65 ? midColor : lowColor

// ============================================================
//  的中率トラッキング（バックテスト統計 - 方向別）
// ============================================================
var int totalSignals = 0
var int hitSignals   = 0
var int totalDirSig  = 0   // 方向予測ありのシグナル数
var int hitDirSig    = 0   // 方向が当たったシグナル数

var float[] sigPrices = array.new_float(0)
var int[]   sigBars   = array.new_int(0)
var float[] sigATRs   = array.new_float(0)
var int[]   sigDirs   = array.new_int(0)   // 1=bull, -1=bear, 0=neutral

if isNew
    totalSignals += 1
    array.push(sigPrices, close)
    array.push(sigBars, bar_index)
    array.push(sigATRs, atrVal)
    array.push(sigDirs, isBullDir and dirProb >= 60 ? 1 : isBearDir and dirProb >= 60 ? -1 : 0)
    if dirProb >= 60
        totalDirSig += 1

if array.size(sigBars) > 0
    toRemove = array.new_int(0)
    for i = 0 to array.size(sigBars) - 1
        sb = array.get(sigBars, i)
        sp = array.get(sigPrices, i)
        sa = array.get(sigATRs, i)
        sd = array.get(sigDirs, i)
        elapsed = bar_index - sb

        if elapsed >= 1 and elapsed <= confirmBars
            maxUp   = high - sp
            maxDown = sp - low
            maxMove = math.max(math.abs(maxUp), math.abs(maxDown))
            if maxMove >= sa * 2.0
                hitSignals += 1
                // 方向の検証
                if sd == 1 and maxUp > maxDown
                    hitDirSig += 1
                else if sd == -1 and maxDown > maxUp
                    hitDirSig += 1
                array.push(toRemove, i)
        else if elapsed > confirmBars
            array.push(toRemove, i)

    if array.size(toRemove) > 0
        for j = array.size(toRemove) - 1 to 0
            idx = array.get(toRemove, j)
            if idx < array.size(sigBars)
                array.remove(sigBars, idx)
                array.remove(sigPrices, idx)
                array.remove(sigATRs, idx)
                array.remove(sigDirs, idx)

hitRate = totalSignals > 0 ? math.round(hitSignals / totalSignals * 100) : 0
dirHitRate = totalDirSig > 0 ? math.round(hitDirSig / totalDirSig * 100) : 0

// ============================================================
//  描画
// ============================================================
// 背景ハイライト
bgCol = showBG and isSignal ?
     (finalScore >= 80 ? color.new(highColor, 70) :
      finalScore >= 65 ? color.new(midColor, 80) :
      finalScore >= minScore ? color.new(lowColor, 88) : na) : na
bgcolor(bgCol, title="Signal BG")

// ラベル（方向＋確率付き）
if showLabels and isNew
    dirTxt = isBullDir and dirProb >= 60 ? " ▲" + str.tostring(dirProb) + "%" :
             isBearDir and dirProb >= 60 ? " ▼" + str.tostring(dirProb) + "%" : ""
    txt = grade + " " + str.tostring(finalScore) + "%" + dirTxt
    lCol = isBullDir and dirProb >= 70 ? color.new(#00E676, 0) :
           isBearDir and dirProb >= 70 ? color.new(#FF1744, 0) : gradeColor
    label.new(bar_index, low - atrVal * 0.5, txt,
         color=lCol, textcolor=#000000,
         size=size.small, style=label.style_label_up)

// シグナルの縦線（A級以上）
if isNew and finalScore >= 65
    vLineCol = isBullDir and dirProb >= 65 ? color.new(#00E676, 50) :
               isBearDir and dirProb >= 65 ? color.new(#FF1744, 50) :
               color.new(highColor, 40)
    vLineW = finalScore >= 80 ? 3 : 2
    line.new(bar_index, high + atrVal * 2, bar_index, low - atrVal * 2,
         color=vLineCol, width=vLineW, style=line.style_solid)

// 方向矢印（確率60%以上で表示、確率が高いほど大きく）
if showLabels and isNew and dirProb >= 60
    arrowSize = dirProb >= 80 ? size.large : dirProb >= 70 ? size.normal : size.small
    if isBullDir
        label.new(bar_index, low - atrVal * 1.8,
             "▲ " + str.tostring(dirProb) + "%",
             color=color.new(#00E676, 0), textcolor=#000000,
             size=arrowSize, style=label.style_label_up)
    else if isBearDir
        label.new(bar_index, high + atrVal * 1.8,
             "▼ " + str.tostring(dirProb) + "%",
             color=color.new(#FF1744, 0), textcolor=#FFFFFF,
             size=arrowSize, style=label.style_label_down)

// 予測レンジ（方向バイアス付き）
expMove = atrVal * 3.0
dirBias = dirProb >= 65 ? (dirProb - 50) / 50.0 : 0.0  // 0~1
expUp = isBullDir ? expMove * (1.0 + dirBias * 0.5) : expMove * (1.0 - dirBias * 0.3)
expDn = isBearDir ? expMove * (1.0 + dirBias * 0.5) : expMove * (1.0 - dirBias * 0.3)
plot(isNew and finalScore >= 65 ? close + expUp : na, "Exp Upper", color=color.new(#00E676, 60), style=plot.style_circles)
plot(isNew and finalScore >= 65 ? close - expDn : na, "Exp Lower", color=color.new(#FF1744, 60), style=plot.style_circles)

// ============================================================
//  アラート
// ============================================================
if alertEnabled and isNew
    dirTxt = isBullDir and dirProb >= 60 ? "UP " + str.tostring(dirProb) + "%" :
             isBearDir and dirProb >= 60 ? "DOWN " + str.tostring(dirProb) + "%" : "---"
    if finalScore >= 80
        alert(syminfo.ticker + " BIG MOVE [S " + str.tostring(finalScore) + "%] " + dirTxt +
             " | Move:" + str.tostring(hitRate) + "% Dir:" + str.tostring(dirHitRate) + "% | " +
             timeframe.period, alert.freq_once_per_bar_close)
    else if finalScore >= 65
        alert(syminfo.ticker + " Move [A " + str.tostring(finalScore) + "%] " + dirTxt + " | " +
             timeframe.period, alert.freq_once_per_bar_close)
    else
        alert(syminfo.ticker + " Move [B " + str.tostring(finalScore) + "%] " + dirTxt + " | " +
             timeframe.period, alert.freq_once_per_bar_close)

// ============================================================
//  ダッシュボード
// ============================================================
var table dash = table.new(position.top_right, 2, 19, bgcolor=color.new(#0D1117, 5), border_width=1, border_color=color.new(#30363D, 0))

if barstate.islast
    // ヘッダー
    table.cell(dash, 0, 0, "Big Move Score", text_color=#FFD600, text_size=size.small)
    scCol = finalScore >= 80 ? #FFD600 : finalScore >= 65 ? #FF9100 : finalScore >= minScore ? #29B6F6 : #484F58
    table.cell(dash, 1, 0, str.tostring(finalScore) + "% [" + grade + "]", text_color=scCol, text_size=size.small)

    // 的中率
    table.cell(dash, 0, 1, "Hit Rate", text_color=#C9D1D9, text_size=size.tiny)
    hrCol = hitRate >= 80 ? #00E676 : hitRate >= 60 ? #FFD600 : #FF1744
    table.cell(dash, 1, 1, str.tostring(hitRate) + "% (" + str.tostring(hitSignals) + "/" + str.tostring(totalSignals) + ")", text_color=hrCol, text_size=size.tiny)

    // レジーム
    table.cell(dash, 0, 2, "Regime", text_color=#C9D1D9, text_size=size.tiny)
    regTxt = isLowVolRegime ? "LOW VOL" : isHighVolRegime ? "HIGH VOL" : "NORMAL"
    regCol = isLowVolRegime ? #FFD600 : isHighVolRegime ? #FF1744 : #8B949E
    table.cell(dash, 1, 2, regTxt, text_color=regCol, text_size=size.tiny)

    // 各要素
    table.cell(dash, 0, 3, "BB Squeeze", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 3, bbSqueeze ? "ON" : "---", text_color=bbSqueeze ? #FFD600 : #484F58, text_size=size.tiny)

    table.cell(dash, 0, 4, "KC Squeeze", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 4, kcSqueeze ? "ON" : "---", text_color=kcSqueeze ? #FF1744 : #484F58, text_size=size.tiny)

    table.cell(dash, 0, 5, "ATR Compress", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(math.round(atrCompression * 100)) + "%", text_color=atrCompression > 0.7 ? #FFD600 : #8B949E, text_size=size.tiny)

    table.cell(dash, 0, 6, "Volume", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 6, volDryUp ? "DRY" : str.tostring(volRatio, "#.#") + "x", text_color=volDryUp ? #FF9100 : #8B949E, text_size=size.tiny)

    table.cell(dash, 0, 7, "NR Bars", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(nrCount) + "/4", text_color=nrCount >= 3 ? #FFD600 : #8B949E, text_size=size.tiny)

    table.cell(dash, 0, 8, "Triangle", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 8, isTriangle ? "YES" : "---", text_color=isTriangle ? #FF1744 : #484F58, text_size=size.tiny)

    table.cell(dash, 0, 9, "MTF Squeeze", text_color=#C9D1D9, text_size=size.tiny)
    mtfTxt = htfSqz1 and htfSqz2 ? "2TF" : htfSqz1 or htfSqz2 ? "1TF" : "---"
    mtfCol = htfSqz1 and htfSqz2 ? #FF1744 : htfSqz1 or htfSqz2 ? #FFD600 : #484F58
    table.cell(dash, 1, 9, mtfTxt, text_color=mtfCol, text_size=size.tiny)

    table.cell(dash, 0, 10, "Cross-Asset", text_color=#C9D1D9, text_size=size.tiny)
    caCount = (dxyVolatile ? 1 : 0) + (goldVolatile ? 1 : 0) + (spxVolatile ? 1 : 0)
    table.cell(dash, 1, 10, str.tostring(caCount) + "/3", text_color=caCount >= 2 ? #FFD600 : #8B949E, text_size=size.tiny)

    table.cell(dash, 0, 11, "Candle Pattern", text_color=#C9D1D9, text_size=size.tiny)
    cpTxt = bullEngulf ? "BullEngulf" : bearEngulf ? "BearEngulf" : isDoji ? "Doji" : isHammer ? "Hammer" : isInvHammer ? "InvHammer" : "---"
    table.cell(dash, 1, 11, cpTxt, text_color=candleSignal ? #FFD600 : #484F58, text_size=size.tiny)

    table.cell(dash, 0, 12, "Season", text_color=#C9D1D9, text_size=size.tiny)
    sTxt = isVolatileDay and isVolatileHour ? "PEAK" : isVolatileDay ? "DAY" : "---"
    table.cell(dash, 1, 12, sTxt, text_color=isVolatileDay ? #FFD600 : #484F58, text_size=size.tiny)

    // 方向予測（メイン）
    dirMainTxt = isBullDir ? "▲ BULL" : isBearDir ? "▼ BEAR" : "— NEUTRAL"
    dirMainCol = isBullDir and dirProb >= 65 ? #00E676 : isBearDir and dirProb >= 65 ? #FF1744 : #8B949E
    table.cell(dash, 0, 13, "Direction", text_color=#FFD600, text_size=size.small)
    table.cell(dash, 1, 13, dirMainTxt, text_color=dirMainCol, text_size=size.small)

    // 方向確率
    table.cell(dash, 0, 14, "Dir Probability", text_color=#C9D1D9, text_size=size.tiny)
    dpCol = dirProb >= 75 ? #00E676 : dirProb >= 62 ? #FFD600 : #8B949E
    table.cell(dash, 1, 14, str.tostring(dirProb) + "% [" + dirConf + "]", text_color=dpCol, text_size=size.tiny)

    // 方向スコア内訳
    table.cell(dash, 0, 15, "Bull / Bear", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 15, str.tostring(bullW, "#.#") + " / " + str.tostring(bearW, "#.#"), text_color=#C9D1D9, text_size=size.tiny)

    // 方向的中率
    table.cell(dash, 0, 16, "Dir Hit Rate", text_color=#C9D1D9, text_size=size.tiny)
    dhCol = dirHitRate >= 70 ? #00E676 : dirHitRate >= 50 ? #FFD600 : #FF1744
    table.cell(dash, 1, 16, str.tostring(dirHitRate) + "% (" + str.tostring(hitDirSig) + "/" + str.tostring(totalDirSig) + ")", text_color=dhCol, text_size=size.tiny)

    // HV
    table.cell(dash, 0, 17, "Hist Vol", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 17, str.tostring(hvol, "#.0") + "%", text_color=hvol < hvolSMA * 0.7 ? #FFD600 : #8B949E, text_size=size.tiny)

    // 適応型
    table.cell(dash, 0, 18, "Adapt Mult", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 18, str.tostring(adaptMult, "#.##") + "x", text_color=adaptMult > 1.0 ? #FFD600 : adaptMult < 1.0 ? #29B6F6 : #8B949E, text_size=size.tiny)
