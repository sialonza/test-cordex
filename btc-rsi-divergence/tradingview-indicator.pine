//@version=5
indicator("BTC RSI Divergence - Ultra v3", overlay=false,
     max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ============================================================
//  BTC限定
// ============================================================
isBTC = str.contains(str.upper(syminfo.basecurrency), "BTC") or str.contains(str.upper(syminfo.ticker), "BTC")
if not isBTC
    runtime.error("BTC専用インジケーターです。BTCチャートに適用してください。")

// ============================================================
//  入力パラメータ
// ============================================================
grp1 = "Core"
rsiLen     = input.int(14, "RSI Period", minval=2, group=grp1)
swingLB    = input.int(5, "Swing Lookback", minval=2, maxval=20, group=grp1)
minConf    = input.int(65, "Min Confidence %", minval=0, maxval=100, group=grp1)

grp2 = "Anti-Fakeout Filters"
minRSIDiff = input.float(4.0, "Min RSI Diff (pt)", minval=1, step=0.5, group=grp2)
minBars    = input.int(6, "Min Bars Between Pivots", minval=2, group=grp2)
maxBars    = input.int(50, "Max Bars Between Pivots", minval=10, group=grp2)
atrLen     = input.int(14, "ATR Period", minval=1, group=grp2)
atrMult    = input.float(0.5, "ATR Price Significance", minval=0.1, step=0.1, group=grp2)
useMTF     = input.bool(true, "MTF Trend Alignment", group=grp2)
useMACD    = input.bool(true, "MACD Histogram Confirm", group=grp2)
useEMA     = input.bool(true, "EMA Trend Filter", group=grp2)
useStochRSI = input.bool(true, "StochRSI Extreme Confirm", group=grp2)
useBB      = input.bool(true, "Bollinger Band Touch", group=grp2)
useOBV     = input.bool(true, "OBV Divergence Confirm", group=grp2)
useVolFilt = input.bool(true, "Volume Decay Filter", group=grp2)
useIntFilt = input.bool(true, "Intermediate Reversal Filter", group=grp2)

grp3 = "Visual"
showRegular = input.bool(true, "Regular Divergence", group=grp3)
showHidden  = input.bool(true, "Hidden Divergence", group=grp3)
bullColor   = input.color(color.new(#00E676, 0), "Bullish", group=grp3)
bearColor   = input.color(color.new(#FF1744, 0), "Bearish", group=grp3)
showConf    = input.bool(true, "Show Confidence %", group=grp3)
showFilters = input.bool(false, "Show Filter Details", group=grp3)

grp4 = "Alerts"
alertMinConf = input.int(75, "Alert Min Confidence %", minval=0, maxval=100, group=grp4)

// ============================================================
//  指標計算
// ============================================================
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)

// MACD
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

// EMA (20/50/200 BTC定番)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// StochRSI
stochRsiK = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, 14), 3)
stochRsiD = ta.sma(stochRsiK, 3)

// Bollinger Bands
[bbUpper, bbBasis, bbLower] = ta.bb(close, 20, 2.0)

// OBV
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvEma = ta.ema(obv, 20)

// 上位足RSI (MTF)
rsi_htf = request.security(syminfo.tickerid, useMTF ? (timeframe.isintraday ? (timeframe.multiplier <= 60 ? "240" : "D") : "W") : timeframe.period, ta.rsi(close, 14), lookahead=barmerge.lookahead_off)

// ============================================================
//  スイングポイント検出
// ============================================================
swingHighPrice = ta.pivothigh(high, swingLB, swingLB)
swingLowPrice  = ta.pivotlow(low, swingLB, swingLB)
rsiSwingHigh   = ta.pivothigh(rsiVal, swingLB, swingLB)
rsiSwingLow    = ta.pivotlow(rsiVal, swingLB, swingLB)

// ============================================================
//  スイングポイント配列
// ============================================================
var float[] priceHighs    = array.new_float()
var int[]   priceHighBars = array.new_int()
var float[] rsiHighs      = array.new_float()
var int[]   rsiHighBars   = array.new_int()
var float[] priceLows     = array.new_float()
var int[]   priceLowBars  = array.new_int()
var float[] rsiLows       = array.new_float()
var int[]   rsiLowBars    = array.new_int()

maxPivots = 20

if not na(swingHighPrice)
    array.unshift(priceHighs, swingHighPrice)
    array.unshift(priceHighBars, bar_index - swingLB)
    if array.size(priceHighs) > maxPivots
        array.pop(priceHighs)
        array.pop(priceHighBars)

if not na(rsiSwingHigh)
    array.unshift(rsiHighs, rsiSwingHigh)
    array.unshift(rsiHighBars, bar_index - swingLB)
    if array.size(rsiHighs) > maxPivots
        array.pop(rsiHighs)
        array.pop(rsiHighBars)

if not na(swingLowPrice)
    array.unshift(priceLows, swingLowPrice)
    array.unshift(priceLowBars, bar_index - swingLB)
    if array.size(priceLows) > maxPivots
        array.pop(priceLows)
        array.pop(priceLowBars)

if not na(rsiSwingLow)
    array.unshift(rsiLows, rsiSwingLow)
    array.unshift(rsiLowBars, bar_index - swingLB)
    if array.size(rsiLows) > maxPivots
        array.pop(rsiLows)
        array.pop(rsiLowBars)

// ============================================================
//  RSIスイングマッチング
// ============================================================
f_matchRSI(rsiBarArr, rsiValArr, targetBar, tol) =>
    bestVal = float(na)
    bestBar = int(na)
    bestD   = tol + 1
    for i = 0 to math.min(array.size(rsiBarArr) - 1, maxPivots - 1)
        sb = array.get(rsiBarArr, i)
        d  = math.abs(sb - targetBar)
        if d <= tol and d < bestD
            bestVal := array.get(rsiValArr, i)
            bestBar := sb
            bestD   := d
    [bestVal, bestBar]

// ============================================================
//  12層フィルターシステム
// ============================================================

// F1: 距離
f_dist(bA, bB) =>
    d = math.abs(bB - bA)
    d >= minBars and d <= maxBars

// F2: RSI差分有意性
f_rsiSig(rA, rB) =>
    math.abs(rA - rB) >= minRSIDiff

// F3: 価格ATR有意性
f_priceSig(pA, pB) =>
    na(atrVal) ? true : math.abs(pA - pB) > atrVal * atrMult

// F4: RSI極限ゾーン (弱気→OB圏、強気→OS圏にいること)
f_rsiZone(rA, rB, isBear) =>
    isBear ? (rA > 60 or rB > 60) : (rA < 40 or rB < 40)

// F5: 出来高減衰（勢い喪失の裏付け）
f_volDecay(bA, bB) =>
    if not useVolFilt
        true
    else
        offA = bar_index - bA
        offB = bar_index - bB
        offA >= 0 and offB >= 0 and offA < 500 and offB < 500 ? volume[offB] < volume[offA] * 1.5 : true

// F6: 中間反転なし
f_noMidRev(bA, bB, rA, rB, isBear) =>
    if not useIntFilt
        true
    else
        ok = true
        lo = math.min(bA, bB)
        hi = math.max(bA, bB)
        for i = lo + 1 to hi - 1
            off = bar_index - i
            if off >= 0 and off < 500
                rv = rsiVal[off]
                if not na(rv)
                    if isBear and rv > math.max(rA, rB) + 3
                        ok := false
                        break
                    if not isBear and rv < math.min(rA, rB) - 3
                        ok := false
                        break
        ok

// F7: MACD ヒストグラム確認（モメンタム減衰の二重確認）
f_macdConfirm(bB, isBear) =>
    if not useMACD
        true
    else
        off = bar_index - bB
        if off >= 1 and off < 499
            if isBear
                // 弱気: MACDヒストグラムが縮小中 or マイナス転換
                macdHist[off] < macdHist[off + 1] or macdHist[off] < 0
            else
                // 強気: MACDヒストグラムが拡大中 or プラス転換
                macdHist[off] > macdHist[off + 1] or macdHist[off] > 0
        else
            true

// F8: EMAトレンド整合性
f_emaAlign(bB, isBear) =>
    if not useEMA
        true
    else
        off = bar_index - bB
        if off >= 0 and off < 500
            c = close[off]
            e20 = ema20[off]
            e50 = ema50[off]
            if isBear
                // 弱気ダイバ: 価格がEMA20より上にいる（まだ高い位置=反転余地あり）
                na(e20) ? true : c > e20 * 0.995
            else
                // 強気ダイバ: 価格がEMA20より下にいる（まだ低い位置=反転余地あり）
                na(e20) ? true : c < e20 * 1.005
        else
            true

// F9: StochRSI極限確認
f_stochConfirm(bB, isBear) =>
    if not useStochRSI
        true
    else
        off = bar_index - bB
        if off >= 0 and off < 500
            sk = stochRsiK[off]
            if isBear
                na(sk) ? true : sk > 70
            else
                na(sk) ? true : sk < 30
        else
            true

// F10: ボリンジャーバンドタッチ
f_bbTouch(bB, isBear) =>
    if not useBB
        true
    else
        off = bar_index - bB
        if off >= 0 and off < 500
            h = high[off]
            l = low[off]
            bu = bbUpper[off]
            bl = bbLower[off]
            if isBear
                na(bu) ? true : h >= bu * 0.998
            else
                na(bl) ? true : l <= bl * 1.002
        else
            true

// F11: OBV乖離確認
f_obvConfirm(bA, bB, isBear) =>
    if not useOBV
        true
    else
        offA = bar_index - bA
        offB = bar_index - bB
        if offA >= 0 and offB >= 0 and offA < 500 and offB < 500
            obvA = obv[offA]
            obvB = obv[offB]
            if na(obvA) or na(obvB)
                true
            else
                if isBear
                    // 弱気: 価格は上がったがOBVは伸びていない
                    obvB <= obvA * 1.05
                else
                    // 強気: 価格は下がったがOBVは減っていない
                    obvB >= obvA * 0.95
        else
            true

// F12: 上位足RSIトレンド整合性（MTF）
f_mtfAlign(isBear) =>
    if not useMTF
        true
    else
        if na(rsi_htf)
            true
        else
            if isBear
                // 弱気: 上位足RSIも過熱圏に近い or 下降中
                rsi_htf > 55
            else
                // 強気: 上位足RSIも売られすぎ圏に近い or 上昇中
                rsi_htf < 45

// ============================================================
//  信頼度スコア（12要素加重 / 150点満点→100%正規化）
// ============================================================
f_confidence(rA, rB, pA, pB, bA, bB, isBear) =>
    s = 0.0

    // (1) RSI乖離度 max20
    s += math.min(20.0, math.abs(rA - rB) * 2.0)

    // (2) RSI極限深度 max15
    if isBear
        mx = math.max(rA, rB)
        s += mx > 78 ? 15.0 : mx > 73 ? 12.0 : mx > 68 ? 9.0 : mx > 63 ? 6.0 : 3.0
    else
        mn = math.min(rA, rB)
        s += mn < 22 ? 15.0 : mn < 27 ? 12.0 : mn < 32 ? 9.0 : mn < 37 ? 6.0 : 3.0

    // (3) 価格ATR比 max12
    if not na(atrVal) and atrVal > 0
        s += math.min(12.0, math.abs(pA - pB) / atrVal * 3.0)

    // (4) 距離適正度 max10
    dist = math.abs(bB - bA)
    s += dist >= 10 and dist <= 30 ? 10.0 : dist >= 7 and dist <= 40 ? 7.0 : 4.0

    // (5) 出来高裏付け max12
    offA = bar_index - bA
    offB = bar_index - bB
    if offA >= 0 and offB >= 0 and offA < 500 and offB < 500
        vA = volume[offA]
        vB = volume[offB]
        if not na(vA) and not na(vB) and vA > 0
            vR = vB / vA
            s += vR < 0.6 ? 12.0 : vR < 0.8 ? 9.0 : vR < 1.0 ? 6.0 : 3.0

    // (6) MACD確認 max10
    if useMACD and f_macdConfirm(bB, isBear)
        s += 10.0

    // (7) EMA整合 max8
    if useEMA and f_emaAlign(bB, isBear)
        s += 8.0

    // (8) StochRSI確認 max10
    if useStochRSI and f_stochConfirm(bB, isBear)
        s += 10.0

    // (9) BB タッチ max8
    if useBB and f_bbTouch(bB, isBear)
        s += 8.0

    // (10) OBV確認 max10
    if useOBV and f_obvConfirm(bA, bB, isBear)
        s += 10.0

    // (11) MTF整合 max15
    if useMTF and f_mtfAlign(isBear)
        s += 15.0

    // (12) 中間反転なしボーナス max10
    if f_noMidRev(bA, bB, rA, rB, isBear)
        s += 10.0

    // 正規化 (150点満点→100%)
    math.min(100.0, math.round(s / 1.4))

// ============================================================
//  フィルター通過数カウント（表示用）
// ============================================================
f_filterCount(rA, rB, pA, pB, bA, bB, isBear) =>
    n = 0
    if f_dist(bA, bB)
        n += 1
    if f_rsiSig(rA, rB)
        n += 1
    if f_priceSig(pA, pB)
        n += 1
    if f_rsiZone(rA, rB, isBear)
        n += 1
    if f_volDecay(bA, bB)
        n += 1
    if f_noMidRev(bA, bB, rA, rB, isBear)
        n += 1
    if f_macdConfirm(bB, isBear)
        n += 1
    if f_emaAlign(bB, isBear)
        n += 1
    if f_stochConfirm(bB, isBear)
        n += 1
    if f_bbTouch(bB, isBear)
        n += 1
    if f_obvConfirm(bA, bB, isBear)
        n += 1
    if f_mtfAlign(isBear)
        n += 1
    n

// ============================================================
//  全フィルター一括チェック（必須6層 全通過必須）
// ============================================================
f_passAllFilters(rA, rB, pA, pB, bA, bB, isBear) =>
    f_dist(bA, bB) and f_rsiSig(rA, rB) and f_priceSig(pA, pB) and f_rsiZone(rA, rB, isBear) and f_noMidRev(bA, bB, rA, rB, isBear) and f_volDecay(bA, bB)

// ============================================================
//  メイン検出 - Regular Bearish
// ============================================================
if not na(swingHighPrice) and array.size(priceHighs) >= 2 and showRegular
    curP = swingHighPrice
    curB = bar_index - swingLB
    [curR, _crb] = f_matchRSI(rsiHighBars, rsiHighs, curB, 3)

    if not na(curR)
        for i = 1 to math.min(array.size(priceHighs) - 1, 6)
            prevP = array.get(priceHighs, i)
            prevB = array.get(priceHighBars, i)
            [prevR, _prb] = f_matchRSI(rsiHighBars, rsiHighs, prevB, 3)

            if not na(prevR) and curP > prevP and curR < prevR
                if f_passAllFilters(prevR, curR, prevP, curP, prevB, curB, true)
                    conf = f_confidence(prevR, curR, prevP, curP, prevB, curB, true)
                    if conf >= minConf
                        line.new(prevB, prevR, curB, curR, color=bearColor, width=2, style=line.style_dashed)
                        fc = f_filterCount(prevR, curR, prevP, curP, prevB, curB, true)
                        lbl = "BEAR " + str.tostring(conf) + "%" + (showFilters ? " [" + str.tostring(fc) + "/12]" : "")
                        label.new(curB, curR + 3, lbl, color=bearColor, textcolor=color.white, size=size.small, style=label.style_label_down)
                        if conf >= alertMinConf
                            alert("BTC BEARISH DIV " + str.tostring(conf) + "% | " + str.tostring(fc) + "/12 filters | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                        break

// ============================================================
//  メイン検出 - Regular Bullish
// ============================================================
if not na(swingLowPrice) and array.size(priceLows) >= 2 and showRegular
    curP = swingLowPrice
    curB = bar_index - swingLB
    [curR, _crb] = f_matchRSI(rsiLowBars, rsiLows, curB, 3)

    if not na(curR)
        for i = 1 to math.min(array.size(priceLows) - 1, 6)
            prevP = array.get(priceLows, i)
            prevB = array.get(priceLowBars, i)
            [prevR, _prb] = f_matchRSI(rsiLowBars, rsiLows, prevB, 3)

            if not na(prevR) and curP < prevP and curR > prevR
                if f_passAllFilters(prevR, curR, prevP, curP, prevB, curB, false)
                    conf = f_confidence(prevR, curR, prevP, curP, prevB, curB, false)
                    if conf >= minConf
                        line.new(prevB, prevR, curB, curR, color=bullColor, width=2, style=line.style_dashed)
                        fc = f_filterCount(prevR, curR, prevP, curP, prevB, curB, false)
                        lbl = "BULL " + str.tostring(conf) + "%" + (showFilters ? " [" + str.tostring(fc) + "/12]" : "")
                        label.new(curB, curR - 3, lbl, color=bullColor, textcolor=color.white, size=size.small, style=label.style_label_up)
                        if conf >= alertMinConf
                            alert("BTC BULLISH DIV " + str.tostring(conf) + "% | " + str.tostring(fc) + "/12 filters | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                        break

// ============================================================
//  Hidden Bearish
// ============================================================
if not na(swingHighPrice) and array.size(priceHighs) >= 2 and showHidden
    curP = swingHighPrice
    curB = bar_index - swingLB
    [curR, _crb] = f_matchRSI(rsiHighBars, rsiHighs, curB, 3)

    if not na(curR)
        for i = 1 to math.min(array.size(priceHighs) - 1, 6)
            prevP = array.get(priceHighs, i)
            prevB = array.get(priceHighBars, i)
            [prevR, _prb] = f_matchRSI(rsiHighBars, rsiHighs, prevB, 3)

            if not na(prevR) and curP < prevP and curR > prevR
                if f_dist(prevB, curB) and f_rsiSig(prevR, curR) and f_priceSig(prevP, curP) and f_noMidRev(prevB, curB, prevR, curR, true)
                    conf = f_confidence(prevR, curR, prevP, curP, prevB, curB, true)
                    if conf >= math.max(minConf, 70)
                        line.new(prevB, prevR, curB, curR, color=color.new(bearColor, 30), width=1, style=line.style_dotted)
                        fc = f_filterCount(prevR, curR, prevP, curP, prevB, curB, true)
                        lbl = "H.BEAR " + str.tostring(conf) + "%" + (showFilters ? " [" + str.tostring(fc) + "/12]" : "")
                        label.new(curB, curR + 2, lbl, color=color.new(bearColor, 30), textcolor=color.white, size=size.tiny, style=label.style_label_down)
                        if conf >= alertMinConf
                            alert("BTC HIDDEN BEAR " + str.tostring(conf) + "% | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                        break

// ============================================================
//  Hidden Bullish
// ============================================================
if not na(swingLowPrice) and array.size(priceLows) >= 2 and showHidden
    curP = swingLowPrice
    curB = bar_index - swingLB
    [curR, _crb] = f_matchRSI(rsiLowBars, rsiLows, curB, 3)

    if not na(curR)
        for i = 1 to math.min(array.size(priceLows) - 1, 6)
            prevP = array.get(priceLows, i)
            prevB = array.get(priceLowBars, i)
            [prevR, _prb] = f_matchRSI(rsiLowBars, rsiLows, prevB, 3)

            if not na(prevR) and curP > prevP and curR < prevR
                if f_dist(prevB, curB) and f_rsiSig(prevR, curR) and f_priceSig(prevP, curP) and f_noMidRev(prevB, curB, prevR, curR, false)
                    conf = f_confidence(prevR, curR, prevP, curP, prevB, curB, false)
                    if conf >= math.max(minConf, 70)
                        line.new(prevB, prevR, curB, curR, color=color.new(bullColor, 30), width=1, style=line.style_dotted)
                        fc = f_filterCount(prevR, curR, prevP, curP, prevB, curB, false)
                        lbl = "H.BULL " + str.tostring(conf) + "%" + (showFilters ? " [" + str.tostring(fc) + "/12]" : "")
                        label.new(curB, curR - 2, lbl, color=color.new(bullColor, 30), textcolor=color.white, size=size.tiny, style=label.style_label_up)
                        if conf >= alertMinConf
                            alert("BTC HIDDEN BULL " + str.tostring(conf) + "% | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
                        break

// ============================================================
//  RSI描画
// ============================================================
rsiPlot = plot(rsiVal, "RSI", color=#A371F7, linewidth=2)
h70 = hline(70, "OB", color=color.new(#FF1744, 50), linestyle=hline.style_dashed)
h30 = hline(30, "OS", color=color.new(#00E676, 50), linestyle=hline.style_dashed)
hline(50, "Mid", color=color.new(#484F58, 70), linestyle=hline.style_dotted)
fill(h70, h30, color=color.new(#A371F7, 95), title="RSI Range")

// ゾーン背景
bgcolor(rsiVal > 75 ? color.new(#FF1744, 85) : rsiVal > 70 ? color.new(#FF1744, 92) : na, title="OB Zone")
bgcolor(rsiVal < 25 ? color.new(#00E676, 85) : rsiVal < 30 ? color.new(#00E676, 92) : na, title="OS Zone")

// StochRSI サブプロット
plot(useStochRSI ? stochRsiK : na, "StochRSI K", color=color.new(#FFD600, 50), linewidth=1)
plot(useStochRSI ? stochRsiD : na, "StochRSI D", color=color.new(#FF6D00, 50), linewidth=1)

// ============================================================
//  ダッシュボード（右上テーブル）
// ============================================================
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(#0D1117, 10), border_width=1, border_color=color.new(#30363D, 0))

if barstate.islast
    table.cell(dash, 0, 0, "Filter", text_color=#8B949E, text_size=size.tiny)
    table.cell(dash, 1, 0, "Status", text_color=#8B949E, text_size=size.tiny)

    table.cell(dash, 0, 1, "RSI", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 1, str.tostring(rsiVal, "#.0"), text_color=rsiVal > 70 ? #FF1744 : rsiVal < 30 ? #00E676 : #C9D1D9, text_size=size.tiny)

    table.cell(dash, 0, 2, "StochRSI", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(stochRsiK, "#.0"), text_color=stochRsiK > 80 ? #FF1744 : stochRsiK < 20 ? #00E676 : #C9D1D9, text_size=size.tiny)

    table.cell(dash, 0, 3, "MACD Hist", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(macdHist, "#.0"), text_color=macdHist > 0 ? #00E676 : #FF1744, text_size=size.tiny)

    table.cell(dash, 0, 4, "HTF RSI", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 4, str.tostring(rsi_htf, "#.0"), text_color=rsi_htf > 60 ? #FF1744 : rsi_htf < 40 ? #00E676 : #C9D1D9, text_size=size.tiny)

    table.cell(dash, 0, 5, "EMA20", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 5, close > ema20 ? "Above" : "Below", text_color=close > ema20 ? #00E676 : #FF1744, text_size=size.tiny)

    table.cell(dash, 0, 6, "BB Pos", text_color=#C9D1D9, text_size=size.tiny)
    bbPos = high >= bbUpper ? "Upper" : low <= bbLower ? "Lower" : "Mid"
    table.cell(dash, 1, 6, bbPos, text_color=bbPos == "Upper" ? #FF1744 : bbPos == "Lower" ? #00E676 : #8B949E, text_size=size.tiny)

    table.cell(dash, 0, 7, "OBV Trend", text_color=#C9D1D9, text_size=size.tiny)
    table.cell(dash, 1, 7, obv > obvEma ? "Bullish" : "Bearish", text_color=obv > obvEma ? #00E676 : #FF1744, text_size=size.tiny)
