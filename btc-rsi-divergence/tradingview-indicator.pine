//@version=5
indicator("BTC RSI Divergence - Ultra Anti-Fakeout v2", overlay=false,
     max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ============================================================
//  BTC限定チェック - BTC以外のチャートでは動作しない
// ============================================================
isBTC = str.contains(str.upper(syminfo.basecurrency), "BTC") or str.contains(str.upper(syminfo.ticker), "BTC")
if not isBTC
    runtime.error("This indicator is designed exclusively for BTC charts. Please apply to a BTC pair (e.g. BTCUSDT, BTCUSD, BTC.D).")

// ============================================================
//  パラメータ
// ============================================================
grp_rsi = "RSI"
rsiLen     = input.int(14, "RSI Period", minval=2, group=grp_rsi)
rsiOB      = input.float(65.0, "Overbought Threshold", group=grp_rsi)
rsiOS      = input.float(35.0, "Oversold Threshold", group=grp_rsi)

grp_swing = "Swing Detection"
swingLB    = input.int(5, "Pivot Lookback", minval=2, maxval=20, group=grp_swing)

grp_filt = "Anti-Fakeout Filters"
minRSIDiff = input.float(3.0, "Min RSI Diff (pt)", step=0.5, group=grp_filt)
minBars    = input.int(5, "Min Pivot Distance (bars)", group=grp_filt)
maxBars    = input.int(60, "Max Pivot Distance (bars)", group=grp_filt)
atrLen     = input.int(14, "ATR Period", group=grp_filt)
atrMult    = input.float(0.5, "ATR Price Significance", step=0.1, group=grp_filt)
useVolFilt = input.bool(true, "Volume Decay Filter", group=grp_filt)
useIntFilt = input.bool(true, "Intermediate Reversal Filter", group=grp_filt)
useMACDFilt = input.bool(true, "MACD Histogram Confirm", group=grp_filt)
useEMAFilt  = input.bool(true, "EMA Trend Alignment", group=grp_filt)
useStochFilt = input.bool(true, "Stoch RSI Cross Confirm", group=grp_filt)
useBBFilt   = input.bool(true, "Bollinger Band Position", group=grp_filt)
useMTFFilt  = input.bool(true, "Multi-TF RSI Confirm", group=grp_filt)
usePostConf = input.bool(true, "Post-Signal Candle Confirm", group=grp_filt)
minConf    = input.int(65, "Min Confidence %", minval=0, maxval=100, group=grp_filt)

grp_vis = "Visual"
showRegular = input.bool(true, "Regular Divergence", group=grp_vis)
showHidden  = input.bool(true, "Hidden Divergence", group=grp_vis)
bullColor   = input.color(color.new(#00C853, 0), "Bullish", group=grp_vis)
bearColor   = input.color(color.new(#FF1744, 0), "Bearish", group=grp_vis)
showConf    = input.bool(true, "Show Confidence %", group=grp_vis)
showFilterTbl = input.bool(true, "Show Filter Dashboard", group=grp_vis)

grp_alert = "Alerts"
alertMinConf = input.int(75, "Alert Min Confidence %", group=grp_alert)

// ============================================================
//  コア指標計算
// ============================================================
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

// MACD
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// EMA（トレンド判定用）
ema20   = ta.ema(close, 20)
ema50   = ta.ema(close, 50)
ema200  = ta.ema(close, 200)

// StochRSI
stochRsiK = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, 14), 3)
stochRsiD = ta.sma(stochRsiK, 3)

// ボリンジャーバンド
[bbMid, bbUp, bbLow] = ta.bb(close, 20, 2.0)

// 上位足RSI（MTF確認用）
htfRsi = request.security(syminfo.tickerid, useMTFFilt ? (timeframe.isintraday ? (timeframe.multiplier <= 60 ? "240" : "D") : "W") : timeframe.period, ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_on)

// ============================================================
//  スイングポイント検出
// ============================================================
swingHighPrice = ta.pivothigh(high, swingLB, swingLB)
swingLowPrice  = ta.pivotlow(low, swingLB, swingLB)
rsiSwingHigh   = ta.pivothigh(rsiVal, swingLB, swingLB)
rsiSwingLow    = ta.pivotlow(rsiVal, swingLB, swingLB)

// ============================================================
//  ピボット履歴（配列）
// ============================================================
var float[] priceHighs    = array.new_float()
var int[]   priceHighBars = array.new_int()
var float[] rsiHighs      = array.new_float()
var int[]   rsiHighBars   = array.new_int()

var float[] priceLows     = array.new_float()
var int[]   priceLowBars  = array.new_int()
var float[] rsiLows       = array.new_float()
var int[]   rsiLowBars    = array.new_int()

maxPivots = 20

if not na(swingHighPrice)
    array.unshift(priceHighs, swingHighPrice)
    array.unshift(priceHighBars, bar_index - swingLB)
    if array.size(priceHighs) > maxPivots
        array.pop(priceHighs)
        array.pop(priceHighBars)
if not na(rsiSwingHigh)
    array.unshift(rsiHighs, rsiSwingHigh)
    array.unshift(rsiHighBars, bar_index - swingLB)
    if array.size(rsiHighs) > maxPivots
        array.pop(rsiHighs)
        array.pop(rsiHighBars)
if not na(swingLowPrice)
    array.unshift(priceLows, swingLowPrice)
    array.unshift(priceLowBars, bar_index - swingLB)
    if array.size(priceLows) > maxPivots
        array.pop(priceLows)
        array.pop(priceLowBars)
if not na(rsiSwingLow)
    array.unshift(rsiLows, rsiSwingLow)
    array.unshift(rsiLowBars, bar_index - swingLB)
    if array.size(rsiLows) > maxPivots
        array.pop(rsiLows)
        array.pop(rsiLowBars)

// ============================================================
//  12層フィルター関数
// ============================================================

// F1: RSI極限ゾーン
f_rsiZone(rsiA, rsiB, isBear) =>
    isBear ? (rsiA > rsiOB or rsiB > rsiOB) : (rsiA < rsiOS or rsiB < rsiOS)

// F2: ピボット間距離
f_distance(barA, barB) =>
    d = math.abs(barB - barA)
    d >= minBars and d <= maxBars

// F3: RSI差分有意性
f_rsiSig(rsiA, rsiB) =>
    math.abs(rsiA - rsiB) >= minRSIDiff

// F4: 価格ATR有意性
f_priceSig(priceA, priceB) =>
    na(atrVal) ? true : math.abs(priceA - priceB) > atrVal * atrMult

// F5: 出来高減衰確認
f_volDecay(barA, barB) =>
    if not useVolFilt
        true
    else
        offA = bar_index - barA
        offB = bar_index - barB
        volA = offA >= 0 and offA < 500 ? volume[offA] : na
        volB = offB >= 0 and offB < 500 ? volume[offB] : na
        na(volA) or na(volB) ? true : volB < volA * 1.2

// F6: 中間反転なし
f_noIntermediate(barA, barB, rsiA, rsiB, isBear) =>
    if not useIntFilt
        true
    else
        clean = true
        lo = math.min(barA, barB)
        hi = math.max(barA, barB)
        for i = lo + 1 to hi - 1
            off = bar_index - i
            if off >= 0 and off < 500
                rv = rsiVal[off]
                if not na(rv)
                    if isBear and rv > math.max(rsiA, rsiB) + 2
                        clean := false
                        break
                    if not isBear and rv < math.min(rsiA, rsiB) - 2
                        clean := false
                        break
        clean

// F7: MACDヒストグラム勢い確認
f_macdConfirm(barB, isBear) =>
    if not useMACDFilt
        true
    else
        off = bar_index - barB
        if off >= 1 and off < 499
            h0 = histLine[off]
            h1 = histLine[off + 1]
            if na(h0) or na(h1)
                true
            else
                // 弱気Div: ヒストグラムが減少傾向（勢い喪失）
                isBear ? h0 < h1 : h0 > h1
        else
            true

// F8: EMAトレンド整合性
f_emaAlign(barB, isBear) =>
    if not useEMAFilt
        true
    else
        off = bar_index - barB
        if off >= 0 and off < 500
            c = close[off]
            e20 = ema20[off]
            e50 = ema50[off]
            if na(c) or na(e20) or na(e50)
                true
            else
                // 弱気Div: 価格がEMA20の上にある（過熱位置からの反転を期待）
                // 強気Div: 価格がEMA20の下にある（売られすぎ位置からの反転を期待）
                isBear ? c > e20 : c < e20
        else
            true

// F9: StochRSIクロス確認
f_stochConfirm(barB, isBear) =>
    if not useStochFilt
        true
    else
        off = bar_index - barB
        if off >= 1 and off < 499
            k0 = stochRsiK[off]
            d0 = stochRsiD[off]
            k1 = stochRsiK[off + 1]
            d1 = stochRsiD[off + 1]
            if na(k0) or na(d0) or na(k1) or na(d1)
                true
            else
                // 弱気: K線がD線を下抜け、または80超からの下降
                // 強気: K線がD線を上抜け、または20割れからの上昇
                if isBear
                    (k0 < d0 and k1 >= d1) or k0 > 75
                else
                    (k0 > d0 and k1 <= d1) or k0 < 25
        else
            true

// F10: ボリンジャーバンド位置
f_bbPosition(barB, isBear) =>
    if not useBBFilt
        true
    else
        off = bar_index - barB
        if off >= 0 and off < 500
            c = close[off]
            bu = bbUp[off]
            bl = bbLow[off]
            bm = bbMid[off]
            if na(c) or na(bu) or na(bl)
                true
            else
                // 弱気Div: 価格がBB上部（ミッド〜上バンド）
                // 強気Div: 価格がBB下部（下バンド〜ミッド）
                isBear ? c > bm : c < bm
        else
            true

// F11: 上位足RSI方向確認
f_mtfConfirm(isBear) =>
    if not useMTFFilt
        true
    else
        if na(htfRsi)
            true
        else
            // 弱気Div: 上位足RSIも高め（55以上）で過熱圏
            // 強気Div: 上位足RSIも低め（45以下）で売られすぎ圏
            isBear ? htfRsi > 50 : htfRsi < 50

// F12: シグナル後の足確認（ポストコンファメーション）
f_postConfirm(barB, isBear) =>
    if not usePostConf
        true
    else
        off = bar_index - barB
        // ポイントBの後に少なくとも1本確定足があるか
        if off >= 2
            c0 = close[off - 1]  // ポイントBの次の足
            c1 = close[off]      // ポイントBの足
            if na(c0) or na(c1)
                true
            else
                // 弱気: 次の足が下落方向
                // 強気: 次の足が上昇方向
                isBear ? c0 < c1 : c0 > c1
        else
            true  // まだ確定足がなければ一旦通す

// ============================================================
//  全フィルター統合チェック
// ============================================================
f_allFilters(barA, barB, rsiA, rsiB, priceA, priceB, isBear, isHidden) =>
    pass_rsiZone     = isHidden ? true : f_rsiZone(rsiA, rsiB, isBear)
    pass_dist        = f_distance(barA, barB)
    pass_rsiSig      = f_rsiSig(rsiA, rsiB)
    pass_priceSig    = f_priceSig(priceA, priceB)
    pass_vol         = f_volDecay(barA, barB)
    pass_noInt       = f_noIntermediate(barA, barB, rsiA, rsiB, isBear)
    pass_macd        = f_macdConfirm(barB, isBear)
    pass_ema         = f_emaAlign(barB, isBear)
    pass_stoch       = f_stochConfirm(barB, isBear)
    pass_bb          = f_bbPosition(barB, isBear)
    pass_mtf         = f_mtfConfirm(isBear)
    pass_post        = f_postConfirm(barB, isBear)

    allPass = pass_rsiZone and pass_dist and pass_rsiSig and pass_priceSig and pass_vol and pass_noInt and pass_macd and pass_ema and pass_stoch and pass_bb and pass_mtf and pass_post

    filterCount = 0
    filterCount += pass_rsiZone ? 1 : 0
    filterCount += pass_dist ? 1 : 0
    filterCount += pass_rsiSig ? 1 : 0
    filterCount += pass_priceSig ? 1 : 0
    filterCount += pass_vol ? 1 : 0
    filterCount += pass_noInt ? 1 : 0
    filterCount += pass_macd ? 1 : 0
    filterCount += pass_ema ? 1 : 0
    filterCount += pass_stoch ? 1 : 0
    filterCount += pass_bb ? 1 : 0
    filterCount += pass_mtf ? 1 : 0
    filterCount += pass_post ? 1 : 0

    [allPass, filterCount]

// ============================================================
//  信頼度スコア（10要素, max 100）
// ============================================================
f_confidence(rsiA, rsiB, priceA, priceB, barA, barB, isBear, filtersPassed) =>
    score = 0.0

    // (1) RSI乖離度 max 15
    score += math.min(15.0, math.abs(rsiA - rsiB) * 1.5)

    // (2) RSI極限度 max 12
    if isBear
        mx = math.max(rsiA, rsiB)
        score += mx > 78 ? 12.0 : mx > 73 ? 10.0 : mx > 68 ? 7.0 : mx > 63 ? 4.0 : 2.0
    else
        mn = math.min(rsiA, rsiB)
        score += mn < 22 ? 12.0 : mn < 27 ? 10.0 : mn < 32 ? 7.0 : mn < 37 ? 4.0 : 2.0

    // (3) 価格ATR比 max 10
    if not na(atrVal) and atrVal > 0
        score += math.min(10.0, math.abs(priceA - priceB) / atrVal * 3.0)

    // (4) 距離適正度 max 8
    dist = math.abs(barB - barA)
    score += dist >= 10 and dist <= 25 ? 8.0 : dist >= 7 and dist <= 35 ? 6.0 : 3.0

    // (5) 出来高裏付け max 10
    offA = bar_index - barA
    offB = bar_index - barB
    volA = offA >= 0 and offA < 500 ? volume[offA] : na
    volB = offB >= 0 and offB < 500 ? volume[offB] : na
    if not na(volA) and not na(volB) and volA > 0
        vR = volB / volA
        score += vR < 0.6 ? 10.0 : vR < 0.8 ? 8.0 : vR < 1.0 ? 6.0 : 3.0
    else
        score += 5.0

    // (6) MACDヒストグラム勾配 max 10
    if offB >= 2 and offB < 498
        h0 = histLine[offB]
        h1 = histLine[offB + 1]
        h2 = histLine[offB + 2]
        if not na(h0) and not na(h1) and not na(h2)
            gradOK = isBear ? (h0 < h1 and h1 < h2) : (h0 > h1 and h1 > h2)
            score += gradOK ? 10.0 : 4.0

    // (7) EMA構造スコア max 8
    if offB >= 0 and offB < 500
        c_ = close[offB]
        e20_ = ema20[offB]
        e50_ = ema50[offB]
        e200_ = ema200[offB]
        if not na(c_) and not na(e20_) and not na(e50_) and not na(e200_)
            if isBear
                score += c_ > e20_ and e20_ > e50_ ? 8.0 : c_ > e20_ ? 5.0 : 2.0
            else
                score += c_ < e20_ and e20_ < e50_ ? 8.0 : c_ < e20_ ? 5.0 : 2.0

    // (8) StochRSI位置スコア max 7
    if offB >= 0 and offB < 500
        sk = stochRsiK[offB]
        if not na(sk)
            if isBear
                score += sk > 80 ? 7.0 : sk > 65 ? 5.0 : 2.0
            else
                score += sk < 20 ? 7.0 : sk < 35 ? 5.0 : 2.0

    // (9) 上位足RSI合致スコア max 10
    if not na(htfRsi)
        if isBear
            score += htfRsi > 65 ? 10.0 : htfRsi > 55 ? 7.0 : htfRsi > 50 ? 4.0 : 1.0
        else
            score += htfRsi < 35 ? 10.0 : htfRsi < 45 ? 7.0 : htfRsi < 50 ? 4.0 : 1.0

    // (10) フィルター通過数ボーナス max 10
    score += math.min(10.0, filtersPassed * 0.83)

    math.min(100.0, math.round(score))

// ============================================================
//  RSIスイングマッチング
// ============================================================
f_matchRSI(rsiBarArr, rsiValArr, targetBar, tol) =>
    bv = float(na)
    bb = int(na)
    bd = tol + 1
    for i = 0 to math.min(array.size(rsiBarArr) - 1, maxPivots - 1)
        sb = array.get(rsiBarArr, i)
        d = math.abs(sb - targetBar)
        if d <= tol and d < bd
            bv := array.get(rsiValArr, i)
            bb := sb
            bd := d
    [bv, bb]

// ============================================================
//  検出状態
// ============================================================
var int   lastBullBar  = 0
var int   lastBearBar  = 0
var float lastBullConf = 0.0
var float lastBearConf = 0.0

// 重複防止（同じバーで複数出さない）
cooldown = 3

// ============================================================
//  Regular Bearish Divergence（価格HH + RSI LH）
// ============================================================
if not na(swingHighPrice) and array.size(priceHighs) >= 2 and showRegular
    cP = swingHighPrice
    cB = bar_index - swingLB
    [cR, _cr] = f_matchRSI(rsiHighBars, rsiHighs, cB, 3)
    if not na(cR) and (bar_index - lastBearBar) > cooldown
        for i = 1 to math.min(array.size(priceHighs) - 1, 6)
            pP = array.get(priceHighs, i)
            pB = array.get(priceHighBars, i)
            [pR, _pr] = f_matchRSI(rsiHighBars, rsiHighs, pB, 3)
            if not na(pR)
                if cP > pP and cR < pR
                    [ok, fc] = f_allFilters(pB, cB, pR, cR, pP, cP, true, false)
                    if ok
                        conf = f_confidence(pR, cR, pP, cP, pB, cB, true, fc)
                        if conf >= minConf
                            line.new(pB, pR, cB, cR, color=bearColor, width=2, style=line.style_dashed)
                            lbl = showConf ? "BEAR " + str.tostring(conf) + "%" : "BEAR"
                            label.new(cB, cR + 3, lbl, color=bearColor, textcolor=color.white, size=size.small, style=label.style_label_down)
                            lastBearBar  := bar_index
                            lastBearConf := conf
                            if conf >= alertMinConf
                                alert("BEARISH DIV | Conf:" + str.tostring(conf) + "% | 12/12 Filters PASS | " + syminfo.ticker, alert.freq_once_per_bar_close)
                            break

// ============================================================
//  Regular Bullish Divergence（価格LL + RSI HL）
// ============================================================
if not na(swingLowPrice) and array.size(priceLows) >= 2 and showRegular
    cP = swingLowPrice
    cB = bar_index - swingLB
    [cR, _cr] = f_matchRSI(rsiLowBars, rsiLows, cB, 3)
    if not na(cR) and (bar_index - lastBullBar) > cooldown
        for i = 1 to math.min(array.size(priceLows) - 1, 6)
            pP = array.get(priceLows, i)
            pB = array.get(priceLowBars, i)
            [pR, _pr] = f_matchRSI(rsiLowBars, rsiLows, pB, 3)
            if not na(pR)
                if cP < pP and cR > pR
                    [ok, fc] = f_allFilters(pB, cB, pR, cR, pP, cP, false, false)
                    if ok
                        conf = f_confidence(pR, cR, pP, cP, pB, cB, false, fc)
                        if conf >= minConf
                            line.new(pB, pR, cB, cR, color=bullColor, width=2, style=line.style_dashed)
                            lbl = showConf ? "BULL " + str.tostring(conf) + "%" : "BULL"
                            label.new(cB, cR - 3, lbl, color=bullColor, textcolor=color.white, size=size.small, style=label.style_label_up)
                            lastBullBar  := bar_index
                            lastBullConf := conf
                            if conf >= alertMinConf
                                alert("BULLISH DIV | Conf:" + str.tostring(conf) + "% | 12/12 Filters PASS | " + syminfo.ticker, alert.freq_once_per_bar_close)
                            break

// ============================================================
//  Hidden Bearish（価格LH + RSI HH → 下落トレンド継続）
// ============================================================
if not na(swingHighPrice) and array.size(priceHighs) >= 2 and showHidden
    cP = swingHighPrice
    cB = bar_index - swingLB
    [cR, _cr] = f_matchRSI(rsiHighBars, rsiHighs, cB, 3)
    if not na(cR) and (bar_index - lastBearBar) > cooldown
        for i = 1 to math.min(array.size(priceHighs) - 1, 6)
            pP = array.get(priceHighs, i)
            pB = array.get(priceHighBars, i)
            [pR, _pr] = f_matchRSI(rsiHighBars, rsiHighs, pB, 3)
            if not na(pR)
                if cP < pP and cR > pR
                    [ok, fc] = f_allFilters(pB, cB, pR, cR, pP, cP, true, true)
                    if ok
                        conf = f_confidence(pR, cR, pP, cP, pB, cB, true, fc)
                        if conf >= math.max(minConf, 70)
                            line.new(pB, pR, cB, cR, color=color.new(bearColor, 30), width=1, style=line.style_dotted)
                            lbl = showConf ? "H.BEAR " + str.tostring(conf) + "%" : "H.BEAR"
                            label.new(cB, cR + 3, lbl, color=color.new(bearColor, 30), textcolor=color.white, size=size.tiny, style=label.style_label_down)
                            lastBearBar := bar_index
                            if conf >= alertMinConf
                                alert("HIDDEN BEAR | Conf:" + str.tostring(conf) + "% | " + syminfo.ticker, alert.freq_once_per_bar_close)
                            break

// ============================================================
//  Hidden Bullish（価格HL + RSI LL → 上昇トレンド継続）
// ============================================================
if not na(swingLowPrice) and array.size(priceLows) >= 2 and showHidden
    cP = swingLowPrice
    cB = bar_index - swingLB
    [cR, _cr] = f_matchRSI(rsiLowBars, rsiLows, cB, 3)
    if not na(cR) and (bar_index - lastBullBar) > cooldown
        for i = 1 to math.min(array.size(priceLows) - 1, 6)
            pP = array.get(priceLows, i)
            pB = array.get(priceLowBars, i)
            [pR, _pr] = f_matchRSI(rsiLowBars, rsiLows, pB, 3)
            if not na(pR)
                if cP > pP and cR < pR
                    [ok, fc] = f_allFilters(pB, cB, pR, cR, pP, cP, false, true)
                    if ok
                        conf = f_confidence(pR, cR, pP, cP, pB, cB, false, fc)
                        if conf >= math.max(minConf, 70)
                            line.new(pB, pR, cB, cR, color=color.new(bullColor, 30), width=1, style=line.style_dotted)
                            lbl = showConf ? "H.BULL " + str.tostring(conf) + "%" : "H.BULL"
                            label.new(cB, cR - 3, lbl, color=color.new(bullColor, 30), textcolor=color.white, size=size.tiny, style=label.style_label_up)
                            lastBullBar := bar_index
                            if conf >= alertMinConf
                                alert("HIDDEN BULL | Conf:" + str.tostring(conf) + "% | " + syminfo.ticker, alert.freq_once_per_bar_close)
                            break

// ============================================================
//  RSI描画
// ============================================================
plot(rsiVal, "RSI", color=#A371F7, linewidth=2)
plot(stochRsiK, "StochRSI K", color=color.new(#58A6FF, 60), linewidth=1, display=display.none)
plot(stochRsiD, "StochRSI D", color=color.new(#F0883E, 60), linewidth=1, display=display.none)

h70 = hline(70, "OB", color=color.new(#F85149, 60), linestyle=hline.style_dashed)
h30 = hline(30, "OS", color=color.new(#3FB950, 60), linestyle=hline.style_dashed)
hline(50, "Mid", color=color.new(#484F58, 70), linestyle=hline.style_dotted)
fill(h70, h30, color=color.new(#A371F7, 95), title="RSI Range")

bgcolor(rsiVal > 70 ? color.new(#F85149, 92) : na, title="OB Zone")
bgcolor(rsiVal < 30 ? color.new(#3FB950, 92) : na, title="OS Zone")

// ============================================================
//  フィルターダッシュボード（テーブル）
// ============================================================
if showFilterTbl and barstate.islast
    var table dash = table.new(position.top_right, 2, 14, bgcolor=color.new(#0D1117, 10), border_color=color.new(#21262D, 0), border_width=1)

    table.cell(dash, 0, 0, "FILTER", text_color=#8B949E, text_size=size.tiny, text_halign=text.align_left)
    table.cell(dash, 1, 0, "STATUS", text_color=#8B949E, text_size=size.tiny, text_halign=text.align_center)

    filters = array.from("F1 RSI Zone", "F2 Distance", "F3 RSI Diff", "F4 ATR Sig", "F5 Vol Decay", "F6 No Reversal", "F7 MACD Hist", "F8 EMA Align", "F9 StochRSI", "F10 BB Pos", "F11 MTF RSI", "F12 Post Candle")
    enabled = array.from(true, true, true, true, useVolFilt, useIntFilt, useMACDFilt, useEMAFilt, useStochFilt, useBBFilt, useMTFFilt, usePostConf)

    for i = 0 to 11
        nm = array.get(filters, i)
        en = array.get(enabled, i)
        table.cell(dash, 0, i + 1, nm, text_color=#C9D1D9, text_size=size.tiny, text_halign=text.align_left)
        table.cell(dash, 1, i + 1, en ? "ON" : "OFF", text_color=en ? #3FB950 : #484F58, text_size=size.tiny, text_halign=text.align_center)

    // 最新シグナル情報
    table.cell(dash, 0, 13, "Last Signal", text_color=#8B949E, text_size=size.tiny, text_halign=text.align_left)
    lastInfo = lastBullConf > 0 or lastBearConf > 0 ? (lastBearConf >= lastBullConf ? "BEAR " + str.tostring(lastBearConf) + "%" : "BULL " + str.tostring(lastBullConf) + "%") : "None"
    lastCol = lastBearConf >= lastBullConf and lastBearConf > 0 ? bearColor : lastBullConf > 0 ? bullColor : color.gray
    table.cell(dash, 1, 13, lastInfo, text_color=lastCol, text_size=size.tiny, text_halign=text.align_center)
